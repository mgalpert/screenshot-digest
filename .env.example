# Get a key at https://aistudio.google.com/apikey
GEMINI_OCR_KEY=your_gemini_api_key_here

# Optional overrides:
# SCREENSHOT_GEMINI_MODEL=gemini-3.5-flash
# SCREENSHOT_DIGEST_HOME=~/.screenshot-digest

# ── Viewer "Send to bot" actions (optional, off by default) ──
# Name shown in the viewer UI:
# SCREENSHOT_BOT_NAME=your bot
#
# Option A — any CLI/script. Prompt is piped on stdin, or replaces {prompt}:
# SCREENSHOT_ACTION_CMD=my-cli chat --stdin
#
# Option B — OpenClaw (https://openclaw.ai) reference integration:
# SCREENSHOT_ACTION_TARGET=your_chat_id
# SCREENSHOT_ACTION_CHANNEL=telegram
# SCREENSHOT_ACTION_AGENT=main
